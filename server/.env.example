# ---------- Server ----------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Long random string. Signs login tokens and ticket QR codes.
JWT_SECRET=change-me-to-a-long-random-string
# Local timezone offset for timetables (India = +05:30)
TZ_OFFSET=+05:30

# ---------- Database ----------
# Leave empty to run in DEMO MODE (in-memory Postgres via PGlite, auto-seeded).
# For Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
DATABASE_URL=

# ---------- Admins ----------
# Comma-separated emails/phones that become admins when they log in.
ADMIN_IDENTIFIERS=admin@govbus.test

# ---------- Google Sign-In ----------
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Use the SAME value as VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=

# ---------- Email (Nodemailer SMTP) ----------
# Leave empty to print emails to the console / dev outbox instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GovBus <no-reply@govbus.test>"

# ---------- SMS (Twilio) ----------
# Leave empty to print SMS to the console / dev outbox instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
